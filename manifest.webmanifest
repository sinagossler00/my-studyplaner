{
  "name": "My Studyplaner",
  "short_name": "Studyplaner",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#f7f1ec",
